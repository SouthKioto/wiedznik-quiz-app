{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "bun run build.ts && netlify deploy --prod --dir=dist",
    "dev": "bun --hot src/index.html",
    "start": "NODE_ENV=production bun src/index.html",
    "build": "bun run build.html"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/bun": "latest"
  }
}
